<!--!
    Secondary production.
    For combinatory production, deliveries are tracked over 27 production cycles.
    This gives the easiest approximation of the 'every 3 months' the player is told.
    27 cycles is about 93 game days, and works in player's favour, accomodating varying length months.
    There is admin with registers to support calculating production ratio over the 27 cargo cycles, and for handling 'Supplied' text to be displayed in industry windows.
    Admin functions are called on both 256 tick and on delivery.
    Actual production is on delivery (uncapped) or 256-tick (capped/warehouse).
-->

<!--! ===== UNCAPPED INDUSTRIES (original logic, unchanged) ===== -->
<tal:uncapped condition="python: getattr(industry, 'base_processing_cap', 0) == 0">

<tal:economies repeat="economy economies">
    produce (${industry.id}_produce_${economy.numeric_id},
        [
            <tal:subtract repeat="cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                <!--! !!! assume just subtracting all for now, don't faff around with remaindered amounts -->
                ${cargo[0]}: incoming_cargo_waiting("${cargo[0]}");
            </tal:subtract>
        ],
        [
            <tal:produce repeat="cargo industry.get_property('prod_cargo_types_with_output_ratios', economy)">
                ${cargo[0]}: (LOAD_PERM(${get_perm_num("total_cargo_to_distribute_this_cycle")}) * ${cargo[1]}) / 8;
            </tal:produce>
        ],
    0)


    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_update_supplied_cycles_remaining_per_cargo_${economy.numeric_id},
        [
            <!--! check if each cargo is delivered in this cycle, and if so reset the supplied cycles remaining
                  NOTE next cycle will -1 so store 28 so we get 27 cycles in total
                  this will cause the industry 'supplied' text to show immediately -->
            <tal:input_cargos repeat="cargo industry.get_accept_cargo_types(economy)">
                STORE_PERM_ALT(
                    ${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.cargo.number))},
                    (incoming_cargo_waiting("${cargo}") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.cargo.number))})
                ),
            </tal:input_cargos>
            0 <!--! spurious 0 because nmlc was running into a parse error without it - this is actually due to empty lists in some economies-->
        ]) {
        return 0;
    }

    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_calculate_current_production_level_${economy.numeric_id},
        [
            <tal:input_cargos repeat="input_cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                <!--! if this cargo was delivered, increase the total production ratio appropriately -->
                STORE_PERM_ALT(
                    ${get_perm_num("current_production_ratio")},
                    LOAD_PERM(${get_perm_num("current_production_ratio")})
                    +
                    (
                        LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.input_cargo.number))})
                        > 0 ? ${input_cargo[1]} : 0
                    )
                ),
            </tal:input_cargos>
            0 <!--! spurious 0 because nmlc was running into a parse error without it - this is actually due to empty lists in some economies-->
        ]) {
        return 0;
    }

    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_calculation_${economy.numeric_id},
            [
                <!--! zero the current production ratio, which we will recalculate during this production cycle -->
                STORE_PERM_ALT(${get_perm_num("current_production_ratio")}, 0),
                <!--! zero the total production from this cycle, as a starting value-->
                STORE_PERM_ALT(${get_perm_num("total_cargo_produced_this_cycle")}, 0),
                ${industry.id}_produce_update_supplied_cycles_remaining_per_cargo_${economy.numeric_id}(),
                ${industry.id}_produce_calculate_current_production_level_${economy.numeric_id}(),
                <!--! add to total amount produced;
                      note that production_ratio is a value 0..8, and is divided by 8 in the calculation here - this is to account for integer maths
                      note also that this has to be in a separate loop to the ratio calculation, have sum ratio over all input cargos before calculating production from each input cargo
                -->
                <tal:total_production repeat="input_cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                    STORE_PERM_ALT(
                        ${get_perm_num("total_cargo_produced_this_cycle")},
                        LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")})
                        + ((incoming_cargo_waiting("${input_cargo[0]}") * LOAD_PERM(${get_perm_num("current_production_ratio")})) / 8)
                    ),
                </tal:total_production>
                <!--! when low cargo amounts are delivered, it's possible that final output cargo amounts < 1, which means no cargo is distributed
                      prevent that by stockpiling produced cargo on each production cycle until there is enough to distribute
                      the case is triggered by low amounts being moved to the produce cycle as a vehicle gradually unloads, and was noticeable with Road Hog trams
                -->
                STORE_PERM_ALT(
                    ${get_perm_num("total_produced_cargo_available")},
                    LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) + LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")})
                ),
                <!--! then check min. distributed by dividing over 8, to get the amount divided by max possible output cargos
                      8 is the pathological case, this could be made more accurate by checking the lowest output ratio in current economy
                      for accuracy, this could also store remainders using mod(8) or so, but eh, TMWFTLB?
                -->

                <!--! OOF, this needs to both assign total_cargo_to_distribute_this_cycle if > 1, and clear total_produced_cargo_available if > 1 -->
                STORE_PERM_ALT(
                    ${get_perm_num("total_cargo_to_distribute_this_cycle")},
                    (LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) / 8) >= 1
                    ?
                    LOAD_PERM(${get_perm_num("total_produced_cargo_available")})
                    :
                    0
                ),
                STORE_PERM_ALT(
                    ${get_perm_num("total_produced_cargo_available")},
                    (LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) / 8) >= 1
                    ?
                    0
                    :
                    LOAD_PERM(${get_perm_num("total_produced_cargo_available")})
                ),
                <!--! if any cargo was produced, reset the closure countdown  -->
                <!--! !! unclear if this is working, separate closure template needs updated for n cargos, currently depends on 3 -->
                STORE_PERM_ALT(
                    ${get_perm_num("closure_counter")},
                    (LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")}) == 0)
                    ?
                    LOAD_PERM(${get_perm_num("closure_counter")})
                    :
                    0
                ),
            ]) {
        ${industry.id}_produce_${economy.numeric_id};
    }
</tal:economies>

switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_cargo_arrival, economy) {
    <tal:economies repeat="economy economies">
        ${economy.numeric_id}: ${industry.id}_produce_calculation_${economy.numeric_id};
    </tal:economies>
}



<!--! 256 ticks doesn't produce, just used to handle current production levels, so produce is just a stub -->
produce(${industry.id}_produce_256_ticks_produce,
    [<!--! no accept in 256 cb -->],
    [<!--! no produce in 256 cb -->],
0)

<!--! set the number of supplied cycles remaining per cargo - used to display 'supplied' (or not) in the industry window -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_update_supplied_cycles_remaining_per_cargo,
    [
        <tal:cargos repeat="cargo_num range(1, 9)">
            <!--! check if each cargo is delivered, and if so update the cycles remaining flag for that to 27,
                  otherwise reduce the number of cycles remaining by 1
                  cap minimum value to 0, avoid -ve values that might overflow eventually -->
            STORE_PERM_ALT(
                ${get_perm_num("supplied_cycles_remaining_cargo_" + str(cargo_num))},
                max(
                    0,
                    LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(cargo_num))})
                    - 1
                )
            ),
        </tal:cargos>
    ]) {
    return 0;
}

switch(FEAT_INDUSTRIES, SELF, ${industry.id}_produce_256_ticks,
    [
        ${industry.id}_update_supplied_cycles_remaining_per_cargo(),
    ]) {
    ${industry.id}_produce_256_ticks_produce;
}

</tal:uncapped>


<!--! ===== CAPPED INDUSTRIES (warehouse model) ===== -->
<!--! Cargo goes into warehouse on delivery, processed per 256-tick from warehouse.
     When warehouse is full, station stops accepting that cargo. -->
<tal:capped condition="python: getattr(industry, 'base_processing_cap', 0) > 0">

<!--! ==================== CARGO ARRIVAL ==================== -->

<tal:economies repeat="economy industry.economies_enabled_for_industry">
    <!--! Produce block: subtract all incoming from station, output 0 (warehouse stores it instead) -->
    produce (${industry.id}_produce_${economy.numeric_id},
        [
            <tal:subtract repeat="cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                ${cargo[0]}: incoming_cargo_waiting("${cargo[0]}");
            </tal:subtract>
        ],
        [
            <tal:produce repeat="cargo industry.get_property('prod_cargo_types_with_output_ratios', economy)">
                ${cargo[0]}: 0;
            </tal:produce>
        ],
    0)

    <!--! Update supplied flags on arrival (same logic as uncapped) -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_update_supplied_cycles_remaining_per_cargo_${economy.numeric_id},
        [
            <tal:input_cargos repeat="cargo industry.get_accept_cargo_types(economy)">
                STORE_PERM_ALT(
                    ${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.cargo.number))},
                    (incoming_cargo_waiting("${cargo}") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.cargo.number))})
                ),
            </tal:input_cargos>
            0
        ]) {
        return 0;
    }

    <!--! Add incoming cargo to warehouse registers -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_warehouse_accept_${economy.numeric_id},
        [
            <tal:input_cargos repeat="cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                STORE_PERM_ALT(
                    ${get_perm_num("warehouse_cargo_" + str(repeat.cargo.number))},
                    LOAD_PERM(${get_perm_num("warehouse_cargo_" + str(repeat.cargo.number))})
                    + incoming_cargo_waiting("${cargo[0]}")
                ),
            </tal:input_cargos>
            0
        ]) {
        return 0;
    }

    <!--! Cargo arrival calculation chain: update supplied flags, warehouse cargo, reset closure counter -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_calculation_${economy.numeric_id},
        [
            <!--! initialize warehouse_max cache if not yet set (before first 256-tick) -->
            STORE_PERM_ALT(${get_perm_num("warehouse_max_cached")},
                max(LOAD_PERM(${get_perm_num("warehouse_max_cached")}), ${industry.warehouse_max_expression})
            ),
            ${industry.id}_produce_update_supplied_cycles_remaining_per_cargo_${economy.numeric_id}(),
            ${industry.id}_warehouse_accept_${economy.numeric_id}(),
            <!--! reset closure counter if any cargo was delivered -->
            <tal:input_cargos repeat="cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                STORE_PERM_ALT(
                    ${get_perm_num("closure_counter")},
                    (incoming_cargo_waiting("${cargo[0]}") > 0)
                    ?
                    0
                    :
                    LOAD_PERM(${get_perm_num("closure_counter")})
                ),
            </tal:input_cargos>
        ]) {
        ${industry.id}_produce_${economy.numeric_id};
    }
</tal:economies>

<!--! Economy router for cargo arrival (same entry point name as uncapped) -->
switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_cargo_arrival, economy) {
    <tal:economies repeat="economy industry.economies_enabled_for_industry">
        ${economy.numeric_id}: ${industry.id}_produce_calculation_${economy.numeric_id};
    </tal:economies>
}


<!--! ==================== 256-TICK PROCESSING ==================== -->

<tal:economies repeat="economy industry.economies_enabled_for_industry">
    <!--! Production ratio calculation from supplied flags (same logic as uncapped) -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_produce_calculate_current_production_level_${economy.numeric_id},
        [
            <tal:input_cargos repeat="input_cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                STORE_PERM_ALT(
                    ${get_perm_num("current_production_ratio")},
                    LOAD_PERM(${get_perm_num("current_production_ratio")})
                    +
                    (
                        LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(repeat.input_cargo.number))})
                        > 0 ? ${input_cargo[1]} : 0
                    )
                ),
            </tal:input_cargos>
            0
        ]) {
        return 0;
    }

    <!--! Produce block for 256-tick: no subtract from station, output calculated amounts -->
    produce (${industry.id}_produce_256_ticks_produce_${economy.numeric_id},
        [<!--! no subtract in 256 cb -->],
        [
            <tal:produce repeat="cargo industry.get_property('prod_cargo_types_with_output_ratios', economy)">
                <tal:bonus_cargo condition="python: industry.is_bonus_cargo(cargo[0])">
                    <!--! scale-unlocked cargo: ratio scales with scale level -->
                    ${cargo[0]}: (LOAD_PERM(${get_perm_num("total_cargo_to_distribute_this_cycle")}) * ${industry.get_bonus_cargo_ratio_expression(cargo[0])}) / 8;
                </tal:bonus_cargo>
                <tal:normal_cargo condition="python: not industry.is_bonus_cargo(cargo[0])">
                    ${cargo[0]}: (LOAD_PERM(${get_perm_num("total_cargo_to_distribute_this_cycle")}) * ${cargo[1]}) / 8;
                </tal:normal_cargo>
            </tal:produce>
        ],
    0)

    <!--! Warehouse processing chain: calculate ratio, process min(warehouse, cap), produce output -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_warehouse_process_${economy.numeric_id},
        [
            <!--! zero production registers -->
            STORE_PERM_ALT(${get_perm_num("current_production_ratio")}, 0),
            STORE_PERM_ALT(${get_perm_num("total_cargo_produced_this_cycle")}, 0),
            <!--! calculate production ratio from supplied flags -->
            ${industry.id}_produce_calculate_current_production_level_${economy.numeric_id}(),
            <!--! required cargos gate: if any required cargo has 0 in warehouse, block all production
                  temp register 0x10 holds the gate flag (1=OK, 0=blocked) -->
            STORE_TEMP(1, 0x10),
            <tal:required_check repeat="req_idx industry.get_required_cargo_warehouse_indices(economy)">
                STORE_TEMP(
                    LOAD_TEMP(0x10) * (LOAD_PERM(${get_perm_num("warehouse_cargo_" + str(req_idx))}) > 0),
                    0x10
                ),
            </tal:required_check>
            <!--! for each input cargo: process min(warehouse, expanded_cap)
                 expanded_cap = base_cap * scale_multiplier / 100
                 gated by required cargos flag in TEMP(0x10) -->
            <tal:input_cargos repeat="input_cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
                <!--! store amount to process in temp register (0 if required cargos missing) -->
                STORE_TEMP(
                    LOAD_TEMP(0x10) *
                    min(
                        LOAD_PERM(${get_perm_num("warehouse_cargo_" + str(repeat.input_cargo.number))}),
                        (${industry.base_processing_cap} * max(LOAD_PERM(${get_perm_num("scale_multiplier")}), 100)) / 100
                    ),
                    ${repeat.input_cargo.index}
                ),
                <!--! add to total produced: to_process * ratio / 8 -->
                STORE_PERM_ALT(
                    ${get_perm_num("total_cargo_produced_this_cycle")},
                    LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")})
                    + ((LOAD_TEMP(${repeat.input_cargo.index}) * LOAD_PERM(${get_perm_num("current_production_ratio")})) / 8)
                ),
                <!--! subtract processed from warehouse -->
                STORE_PERM_ALT(
                    ${get_perm_num("warehouse_cargo_" + str(repeat.input_cargo.number))},
                    LOAD_PERM(${get_perm_num("warehouse_cargo_" + str(repeat.input_cargo.number))})
                    - LOAD_TEMP(${repeat.input_cargo.index})
                ),
            </tal:input_cargos>
            <!--! stockpile/distribute logic (same as uncapped cargo arrival) -->
            STORE_PERM_ALT(
                ${get_perm_num("total_produced_cargo_available")},
                LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) + LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")})
            ),
            STORE_PERM_ALT(
                ${get_perm_num("total_cargo_to_distribute_this_cycle")},
                (LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) / 8) >= 1
                ?
                LOAD_PERM(${get_perm_num("total_produced_cargo_available")})
                :
                0
            ),
            STORE_PERM_ALT(
                ${get_perm_num("total_produced_cargo_available")},
                (LOAD_PERM(${get_perm_num("total_produced_cargo_available")}) / 8) >= 1
                ?
                0
                :
                LOAD_PERM(${get_perm_num("total_produced_cargo_available")})
            ),
            <!--! closure counter reset -->
            STORE_PERM_ALT(
                ${get_perm_num("closure_counter")},
                (LOAD_PERM(${get_perm_num("total_cargo_produced_this_cycle")}) == 0)
                ?
                LOAD_PERM(${get_perm_num("closure_counter")})
                :
                0
            ),
        ]) {
        ${industry.id}_produce_256_ticks_produce_${economy.numeric_id};
    }
</tal:economies>

<!--! Supplied cycles countdown for 256-tick (same as uncapped) -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_update_supplied_cycles_remaining_per_cargo,
    [
        <tal:cargos repeat="cargo_num range(1, 9)">
            STORE_PERM_ALT(
                ${get_perm_num("supplied_cycles_remaining_cargo_" + str(cargo_num))},
                max(
                    0,
                    LOAD_PERM(${get_perm_num("supplied_cycles_remaining_cargo_" + str(cargo_num))})
                    - 1
                )
            ),
        </tal:cargos>
    ]) {
    return 0;
}

<!--! Sum scale chunk counts from tile scanners -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_sum_scale_chunks,
    [
        STORE_PERM_ALT(${get_perm_num("scale_tile_count")},
            LOAD_PERM(${get_perm_num("scale_chunk_count_0")})
            + LOAD_PERM(${get_perm_num("scale_chunk_count_1")})
            + LOAD_PERM(${get_perm_num("scale_chunk_count_2")})
            + LOAD_PERM(${get_perm_num("scale_chunk_count_3")})
        ),
    ]) {
    return 0;
}

<!--! Calculate scale multiplier from tile count and GRF parameter thresholds -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_calculate_scale_multiplier,
    [
        STORE_PERM_ALT(${get_perm_num("scale_multiplier")},
            (LOAD_PERM(${get_perm_num("scale_tile_count")}) >= scale_threshold_high)
            ? primary_scale_bonus_high
            : (LOAD_PERM(${get_perm_num("scale_tile_count")}) >= scale_threshold_medium)
            ? primary_scale_bonus_medium
            : (LOAD_PERM(${get_perm_num("scale_tile_count")}) >= scale_threshold_low)
            ? primary_scale_bonus_low
            : 100
        ),
    ]) {
    return 0;
}

<!--! 256-tick: economy router for warehouse processing -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_produce_256_ticks_route, economy) {
    <tal:economies repeat="economy industry.economies_enabled_for_industry">
        ${economy.numeric_id}: ${industry.id}_warehouse_process_${economy.numeric_id};
    </tal:economies>
}

<!--! 256-tick entry: sum scale, calculate multiplier, cache warehouse max, countdown supplied, process -->
switch(FEAT_INDUSTRIES, SELF, ${industry.id}_produce_256_ticks,
    [
        ${industry.id}_sum_scale_chunks(),
        ${industry.id}_calculate_scale_multiplier(),
        <!--! cache warehouse_max so tile callbacks (cargo_amount_accept) just read one register -->
        STORE_PERM_ALT(${get_perm_num("warehouse_max_cached")}, ${industry.warehouse_max_expression}),
        ${industry.id}_update_supplied_cycles_remaining_per_cargo(),
    ]) {
    ${industry.id}_produce_256_ticks_route;
}


<!--! ==================== STOP ACCEPT CARGO ==================== -->

<tal:economies repeat="economy industry.economies_enabled_for_industry">
    <!--! Per-economy: check warehouse level for the queried cargo type (matched by CTT index) -->
    switch (FEAT_INDUSTRIES, SELF, ${industry.id}_stop_accept_cargo_${economy.numeric_id},
        getbits(extra_callback_info2, 0, 8)) {
        <tal:input_cargos repeat="cargo industry.get_property('accept_cargos_with_input_ratios', economy)">
            ${industry.get_cargo_ctt_index(cargo[0], economy)}: (LOAD_PERM(${get_perm_num("warehouse_cargo_" + str(repeat.cargo.number))}) >= ${industry.warehouse_max}) ? 0 : 1;
        </tal:input_cargos>
        1; <!--! default: accept unknown cargos -->
    }
</tal:economies>

<!--! Economy router -->
switch (FEAT_INDUSTRIES, SELF, ${industry.id}_stop_accept_cargo, economy) {
    <tal:economies repeat="economy industry.economies_enabled_for_industry">
        ${economy.numeric_id}: ${industry.id}_stop_accept_cargo_${economy.numeric_id};
    </tal:economies>
}

</tal:capped>
