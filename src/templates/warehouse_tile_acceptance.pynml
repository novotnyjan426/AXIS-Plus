<!--! Tile-level acceptance callbacks for warehouse-capped industries.
     Per-economy cargo_amount_accept: slot order matches per-economy accepted_cargos.
     Each tile item references its economy's callback directly (no economy dispatch needed). -->

<tal:block condition="python: getattr(industry, 'base_processing_cap', 0) > 0">

    <tal:economies repeat="economy industry.economies_enabled_for_industry">
        switch(FEAT_INDUSTRYTILES, PARENT, ${industry.id}_cargo_amount_accept_${economy.numeric_id}, 0) {
            return ${industry.get_packed_cargo_amount_accept_per_economy(economy)};
        }
    </tal:economies>

</tal:block>
